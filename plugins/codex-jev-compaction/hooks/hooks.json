{
  "description": "Create a Jev-selected checkpoint before compaction and restore it immediately afterward.",
  "hooks": {
    "PreCompact": [
      {
        "matcher": "^(manual|auto)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/codex-jev-compaction.mjs\" pre-compact",
            "timeout": 30,
            "statusMessage": "Selecting durable context with Jev"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "^compact$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/codex-jev-compaction.mjs\" session-start",
            "timeout": 5,
            "additionalContextLimit": 2600,
            "statusMessage": "Restoring selected compaction context"
          }
        ]
      }
    ]
  }
}
